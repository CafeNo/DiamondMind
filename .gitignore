# DiamondMind Project - GitIgnore

# =============================================================================
# FRONTEND (React + Vite + TypeScript)
# =============================================================================

# Dependencies
frontend/node_modules/
# package-lock.json is intentionally excluded — regenerate with `npm install`
frontend/package-lock.json

# Build outputs
frontend/dist/
frontend/build/

# Environment files
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Vite cache (covers both .vite/ root cache and node_modules/.vite/)
frontend/.vite/
frontend/node_modules/.vite/
frontend/vite.config.ts.timestamp-*

# TypeScript
frontend/*.tsbuildinfo

# ESLint
frontend/.eslintcache

# =============================================================================
# BACKEND (Go)
# =============================================================================

# Environment / secrets — NEVER commit these
backend/.env
backend/.env.*
.env
.env.*

# Binaries for programs and plugins
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib
backend/cmd/server/server
backend/cmd/server/server.exe

# Test binary, built with `go test -c`
backend/*.test

# Output of the go coverage tool
backend/*.out

# Dependency directories
backend/vendor/

# Go workspace file
backend/go.work

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =============================================================================
# LOGS AND TEMPORARY FILES
# =============================================================================

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# =============================================================================
# DEPLOYMENT AND PRODUCTION
# =============================================================================

# Production environment files
.env.production

# Docker — only ignore override file (main Dockerfile & compose should be committed)
docker-compose.override.yml

# =============================================================================
# MISCELLANEOUS
# =============================================================================

# Temporary folders
tmp/
temp/

# Archives
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Backup files
*.backup
*.bak
*.tmp 